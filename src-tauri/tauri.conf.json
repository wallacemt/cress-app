{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cress",
  "version": "0.1.0",
  "identifier": "dev.wallacesantana.cress",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cress",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' asset: 'wasm-unsafe-eval'; worker-src 'self' asset: blob:; connect-src ipc: http://ipc.localhost asset: https://api.github.com https://github.com; media-src 'self' asset: blob:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Wallace Santana",
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": { "preload": ["sqlite:cress.db"] },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": ["https://github.com/wallacemt/cress-app/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyODU5ODZENTZDNENENzMKUldSenpjUldiWmlGQXB3Q3YzMFF1K1dZdkMydjNhQW9OQ050SEhFbFllM3g2cm8xN1NEU3FESnkK"
    }
  }
}
