{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cress",
  "version": "0.1.0",
  "identifier": "dev.wallacesantana.cress",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cress",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src ipc: http://ipc.localhost asset:; media-src 'self' asset: blob:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Wallace Santana",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": { "sql": { "preload": ["sqlite:cress.db"] } }
}
